// Base HTML document shared by every page. Pages compose it as
// <page-layout title="...">...</page-layout>; the page body renders where
// <${input.content}/> sits.
export interface Input {
  title?: string;
  head?: Marko.AttrTag<{ content: Marko.Body }>;
  content: Marko.Body;
}

<!DOCTYPE html>
<html lang="en" class="h-full dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/assets/fonts/geist/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <title>${input.title ?? "go-marko App"}</title>
    <link href="/assets/css/output.css" rel="stylesheet">
    <html-script src="/assets/js/theme.js" defer></html-script>
    <if=input.head>
      <${input.head.content}/>
    </if>
  </head>
  <body class="h-full">
    <div class="flex h-full flex-col">
      <navbar/>
      <main class="flex-1">
        <${input.content}/>
      </main>
    </div>
  </body>
</html>
