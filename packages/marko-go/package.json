{
  "name": "marko-go",
  "version": "0.1.0",
  "description": "Compile Marko templates to type-safe Go render functions, with a templ-style --watch/--proxy dev loop.",
  "type": "module",
  "author": "Saulo Vallory <me@saulo.engineer>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svallory/go-marko.git",
    "directory": "packages/marko-go"
  },
  "homepage": "https://go-marko.saulo.tech",
  "bugs": {
    "url": "https://github.com/svallory/go-marko/issues"
  },
  "keywords": ["marko", "go", "golang", "templates", "codegen", "templ", "ssr", "cli", "compiler"],
  "bin": {
    "marko-go": "./src/cli.mjs"
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "bun test && bun ../../scripts/release-check.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@marko/compiler": "5.42.1",
    "@marko/runtime-tags": "6.3.42",
    "chokidar": "^5.0.0"
  }
}
