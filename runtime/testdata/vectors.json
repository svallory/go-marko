    "expectedPayload": "_=>[1,{c:!0},{c:5}],\"YJk3cdf 2 pfc_9NX 1\"",
    "expectedHTML": "<button>5<!--M_*2 b--></button><!--M_*2 a--><!--M_|1 a 2--><button>toggle</button><!--M_*1 b--><SCRIPT/>"
  },
  {
    "name": "tpl/p08-for",
    "kind": "template",
    "scopes": "<let/items=[1,2,3]>\n<for|i| of=items><button onClick() { items=[...items,i] }>${i}</button></for>",
    "expectedPayload": "_=>[1,{b:[1,2,3]},{d:1},{d:2},{d:3}],\"HXq2rTs 2 3 4\"",
    "expectedHTML": "<button>1<!--M_*2 b--></button><!--M_*2 a--><button>2<!--M_*3 b--></button><!--M_*3 a--><button>3<!--M_*4 b--></button><!--M_*4 a--><!--M_|1 a 4 3 2--><SCRIPT/>"
  },
  {
