  {
    "name": "tpl/p01-counter",
    "kind": "template",
    "scopes": "<let/n=0>\n<button onClick() { n++ }>${n}</button>",
    "expectedPayload": "_=>[1,{c:0}],\"WDGvDBz 1\"",
    "expectedHTML": "<button>0<!--M_*1 b--></button><!--M_*1 a--><SCRIPT/>"
  },
  {
    "name": "tpl/p02-two-islands",
    "kind": "template",
    "scopes": "<let/a=0>\n<let/b=100>\n<button onClick() { a++ }>${a}</button>\n<button onClick() { b++ }>${b}</button>",
    "expectedPayload": "_=>[1,{e:0,f:100}],\"YIFnz1G 1\"",
    "expectedHTML": "<button>0<!--M_*1 b--></button><!--M_*1 a--><button>100<!--M_*1 d--></button><!--M_*1 c--><SCRIPT/>"
  },
  {
    "name": "tpl/p03-scalars",
    "kind": "template",
    "scopes": "<let/s=\"hi\">\n<let/big=\"a string longer than twelve chars\">\n<let/f=1.5>\n<let/neg=-42>\n<let/t=true>\n<let/f2=false>\n<button onClick() { s+=\"x\"; big+=\"y\"; f++; neg--; t=!t; f2=!f2 }>${s}${big}${f}${neg}${t}${f2}</button>",
    "expectedPayload": "_=>[1,{h:\"hi\",i:\"a string longer than twelve chars\",j:1.5,k:-42,l:!0,m:!1}],\"usXo2yb 1\"",
    "expectedHTML": "<button>hi<!--M_*1 b--><!>a string longer than twelve chars<!--M_*1 c--><!>1.5<!--M_*1 d--><!>-42<!--M_*1 e--><!>true<!--M_*1 f--><!><!--M_*1 g--></button><!--M_*1 a--><SCRIPT/>"
  },
  {
    "name": "tpl/p04-obj-arr",
    "kind": "template",
    "scopes": "<let/o={x:1,y:\"two\",z:[1,2,3]}>\n<let/arr=[1,\"two\",true,null]>\n<button onClick() { o.x++; arr.push(1) }>${o.x}${arr.length}</button>",
    "expectedPayload": "_=>[1,{e:1,f:[1,\"two\",!0,null]}],\"EuwvaWu 1\"",
    "expectedHTML": "<button>14</button><!--M_*1 a--><SCRIPT/>"
  },
  {
    "name": "tpl/p05-composed",
    "kind": "template",
    "scopes": "import Btn from \"./btn.marko\";\n<let/n=0>\n<Btn cls=\"x\" onClick() { n++ }>Hi ${n}</Btn>\n<Btn cls=\"y\">Static</Btn>",
    "expectedPayload": "_=>[1,{d:new Set([_(3)])},1,{_:_(1)}]",
    "expectedHTML": "<button class=x>Hi <!>0<!--M_*3 a--></button><button class=y>Static</button><SCRIPT/>"
  },
  {
    "name": "tpl/p06-nested-let",
    "kind": "template",
    "scopes": "<let/outer=1>\n<div>\n  <let/inner=2>\n  <button onClick() { outer++; inner++ }>${outer}-${inner}</button>\n</div>",
    "expectedPayload": "_=>[1,{d:1,e:2}],\"S6MGjrc 1\"",
    "expectedHTML": "<div><button>1<!--M_*1 b-->-<!>2<!--M_*1 c--></button><!--M_*1 a--></div><SCRIPT/>"
  },
  {
    "name": "tpl/p07-if",
